curl {{ fullUrl }} \
    -X POST \
    -d '{
{{ providerInputs.asCurlString }},
        "parameters": {"candidate_labels": ["refund", "legal", "faq"]}
    }' \
    -H 'Content-Type: application/json' \
    -H 'Authorization: {{ authorizationHeader }}'
{% if billTo %} \
    -H 'X-HF-Bill-To: {{ billTo }}'
{% endif %}
