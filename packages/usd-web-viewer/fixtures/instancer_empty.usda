#usda 1.0

# An instancer with no positions places nothing: its prototype's geometry is
# built but never drawn.
def PointInstancer "I"
{
    point3f[] positions = []
    int[] protoIndices = []
    rel prototypes = [</I/A>]

    def Mesh "A"
    {
        int[] faceVertexCounts = [3]
        int[] faceVertexIndices = [0, 1, 2]
        point3f[] points = [(0, 0, 0), (1, 0, 0), (0, 1, 0)]
    }
}
