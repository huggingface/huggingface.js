#usda 1.0
(
    defaultPrim = "Robot"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Robot" (
    prepend apiSchemas = ["PhysicsArticulationRootAPI"]
)
{
    def Xform "base" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI"]
    )
    {
        def Cube "box"
        {
            double size = 0.2
        }
    }

    def Xform "arm" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI"]
    )
    {
        double3 xformOp:translate = (0, 0, 0.6)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Cube "box"
        {
            double size = 0.1
        }
    }

    def Xform "slider" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI"]
    )
    {
        double3 xformOp:translate = (0, 0, 1)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Cube "box"
        {
            double size = 0.05
        }
    }

    def PhysicsRevoluteJoint "shoulder"
    {
        rel physics:body0 = </Robot/base>
        rel physics:body1 = </Robot/arm>
        point3f physics:localPos0 = (0, 0, 0.1)
        point3f physics:localPos1 = (0, 0, -0.5)
        quatf physics:localRot0 = (1, 0, 0, 0)
        quatf physics:localRot1 = (1, 0, 0, 0)
        uniform token physics:axis = "Y"
        float physics:lowerLimit = -90
        float physics:upperLimit = 90
    }

    # Targets the arm's mesh, not the arm: the frame is relative to the mesh.
    def PhysicsPrismaticJoint "extend"
    {
        rel physics:body0 = </Robot/arm/box>
        rel physics:body1 = </Robot/slider>
        point3f physics:localPos0 = (0, 0, 0.5)
        point3f physics:localPos1 = (0, 0, 0.1)
        uniform token physics:axis = "Z"
        float physics:lowerLimit = 0
        float physics:upperLimit = 0.3
    }

    def PhysicsFixedJoint "anchor"
    {
        rel physics:body1 = </Robot/base>
    }

    def PhysicsRevoluteJoint "disabled"
    {
        bool physics:jointEnabled = 0
        rel physics:body0 = </Robot/base>
        rel physics:body1 = </Robot/slider>
    }
}
