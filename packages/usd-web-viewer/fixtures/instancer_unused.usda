#usda 1.0

# An instancer with two prototypes whose one instance uses only the first: A
# is drawn once at (10, 0, 0); B is never drawn where it is authored.
def PointInstancer "I"
{
    point3f[] positions = [(10, 0, 0)]
    int[] protoIndices = [0]
    rel prototypes = [</I/A>, </I/B>]

    def Mesh "A"
    {
        int[] faceVertexCounts = [3]
        int[] faceVertexIndices = [0, 1, 2]
        point3f[] points = [(0, 0, 0), (1, 0, 0), (0, 1, 0)]
    }

    def Mesh "B"
    {
        int[] faceVertexCounts = [3]
        int[] faceVertexIndices = [0, 1, 2]
        point3f[] points = [(0, 0, 0), (1, 0, 0), (0, 1, 0)]
    }
}
