#usda 1.0
(
    defaultPrim = "Robot"
)

# Links made instanceable without arcs of their own, as robot assets author
# them: they are instances only once the robot is referenced.
def Xform "Robot"
{
    def Xform "base" (
        instanceable = true
    )
    {
        def Mesh "mesh"
        {
            int[] faceVertexCounts = [3]
            int[] faceVertexIndices = [0, 1, 2]
            point3f[] points = [(0, 0, 0), (1, 0, 0), (0, 1, 0)]
        }
    }

    def Xform "arm" (
        instanceable = true
    )
    {
        double3 xformOp:translate = (0, 0, 2)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Xform "hand" (
            instanceable = true
            prepend references = </Robot/base>
        )
        {
        }
    }
}
