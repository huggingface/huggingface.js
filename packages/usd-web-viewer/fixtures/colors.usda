#usda 1.0

# Where vertex colors come from:
# - /Vertex, /Constant: per-vertex displayColor becomes a color attribute (the
#   material stays white); a constant one tints the material instead.
# - /Tinted: a preview material whose diffuse color reads a primvar other than
#   displayColor (`tint`): its per-vertex values become the color attribute and
#   the material stays white.
# - /Subset: a GeomSubset bound to a material that reads displayColor, covering
#   the mesh's only face: that face draws with the subset's material and the
#   per-vertex colors; the mesh's own grey material is left unused.
def Mesh "Vertex"
{
    int[] faceVertexCounts = [3]
    int[] faceVertexIndices = [0, 1, 2]
    point3f[] points = [(0, 0, 0), (1, 0, 0), (0, 1, 0)]
    color3f[] primvars:displayColor = [(1, 0, 0), (0, 1, 0), (0, 0, 1)] (interpolation = "vertex")
}

def Mesh "Constant"
{
    int[] faceVertexCounts = [3]
    int[] faceVertexIndices = [0, 1, 2]
    point3f[] points = [(0, 0, 0), (1, 0, 0), (0, 1, 0)]
    color3f[] primvars:displayColor = [(0.5, 0.25, 1)]
}

def Mesh "Tinted" (
    prepend apiSchemas = ["MaterialBindingAPI"]
)
{
    int[] faceVertexCounts = [3]
    int[] faceVertexIndices = [0, 1, 2]
    point3f[] points = [(0, 0, 0), (1, 0, 0), (0, 1, 0)]
    color3f[] primvars:tint = [(1, 0, 0), (0, 1, 0), (0, 0, 1)] (interpolation = "vertex")
    rel material:binding = </TintMat>
}

def Material "TintMat"
{
    token outputs:surface.connect = </TintMat/P.outputs:surface>

    def Shader "P"
    {
        uniform token info:id = "UsdPreviewSurface"
        color3f inputs:diffuseColor.connect = </TintMat/Reader.outputs:result>
        token outputs:surface
    }

    def Shader "Reader"
    {
        uniform token info:id = "UsdPrimvarReader_float3"
        string inputs:varname = "tint"
        float3 outputs:result
    }
}

def Mesh "Subset" (
    prepend apiSchemas = ["MaterialBindingAPI"]
)
{
    int[] faceVertexCounts = [3]
    int[] faceVertexIndices = [0, 1, 2]
    point3f[] points = [(0, 0, 0), (1, 0, 0), (0, 1, 0)]
    color3f[] primvars:displayColor = [(1, 0, 0), (0, 1, 0), (0, 0, 1)] (interpolation = "vertex")
    rel material:binding = </Base>

    def GeomSubset "Part" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        uniform token elementType = "face"
        uniform token familyName = "materialBind"
        int[] indices = [0]
        rel material:binding = </SubsetMat>
    }
}

def Material "SubsetMat"
{
    token outputs:surface.connect = </SubsetMat/P.outputs:surface>

    def Shader "P"
    {
        uniform token info:id = "UsdPreviewSurface"
        color3f inputs:diffuseColor.connect = </SubsetMat/Reader.outputs:result>
        token outputs:surface
    }

    def Shader "Reader"
    {
        uniform token info:id = "UsdPrimvarReader_float3"
        string inputs:varname = "displayColor"
        float3 outputs:result
    }
}

def Material "Base"
{
    token outputs:surface.connect = </Base/P.outputs:surface>

    def Shader "P"
    {
        uniform token info:id = "UsdPreviewSurface"
        color3f inputs:diffuseColor = (0.5, 0.5, 0.5)
        token outputs:surface
    }
}
